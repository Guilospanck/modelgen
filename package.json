{
  "name": "@guilospanck/modelgen",
  "version": "0.2.0",
  "description": "Generate 3D models (GLB, USDZ) from a CLI or an MCP server. Built for AI agents.",
  "license": "MIT",
  "author": "Guilherme Pereira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guilospanck/modelgen.git"
  },
  "keywords": ["3d", "procedural", "usdz", "gltf", "glb", "mcp", "cli", "generator"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "modelgen": "dist/cli/bin.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/engine/lib.js",
    "./sdf": "./dist/engine/sdf.js",
    "./anatomy": "./dist/engine/anatomy.js",
    "./overlay_lib": "./dist/engine/overlay.js",
    "./render": "./dist/engine/render.js",
    "./anchors": "./dist/engine/anchors.js",
    "./life/dsl": "./dist/engine/life/dsl.js",
    "./life/clips": "./dist/engine/life/clips.js",
    "./life/rigs": "./dist/engine/life/rigs.js",
    "./document": "./dist/document/index.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "build:npm": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/bin.js",
    "build:bin": "bun run scripts/build-binaries.ts",
    "dev": "bun run src/cli/bin.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
